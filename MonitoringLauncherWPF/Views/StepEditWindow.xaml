<Window x:Class="MonitoringLauncherWPF.Views.StepEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Step Details" Width="600"
        SizeToContent="Height" MinHeight="400" MaxHeight="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="VisibleForStartProcess" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step.Type}" Value="StartProcess">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="VisibleForUIA" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step.Type}" Value="Click">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Step.Type}" Value="TypeText">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Step.Type}" Value="VerifyElementExists">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleForTypeText" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step.Type}" Value="TypeText">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleForWindowOp" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Step.Type}" Value="WindowOperation">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgDark}" CornerRadius="10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseDown="HeaderBorder_MouseDown" Padding="16,12">
                <TextBlock Text="Szczegóły kroku automatyzacji" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="15"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,10">
                <StackPanel>
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Action Type:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TypeTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Foreground="{StaticResource AccentPrimary}" Padding="8,6" Background="Transparent"/>
                    </Grid>

                    <StackPanel Style="{StaticResource VisibleForStartProcess}">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ścieżka do aplikacji:" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text=" ⓘ" Foreground="{StaticResource TextSecondary}" Cursor="Help">
                                    <TextBlock.ToolTip>
                                        <ToolTip Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSubtle}" Placement="Right">
                                            <TextBlock Text="Pełna ścieżka do pliku wykonywalnego (.exe) lub skryptu (.bat).&#x0a;Przykład: 'C:\Program Files\Aplikacja\app.exe'" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="5"/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <TextBox x:Name="AppPathTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" Padding="8,6"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Argumenty Startowe:" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text=" ⓘ" Foreground="{StaticResource TextSecondary}" Cursor="Help">
                                    <TextBlock.ToolTip>
                                        <ToolTip Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSubtle}" Placement="Right">
                                            <TextBlock Text="Parametry przekazywane podczas uruchamiania. Obsługuje tagi KEEPASS.&#x0a;Przykład: '-inprivate http://strona.com'" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="5"/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <TextBox x:Name="ArgumentsTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" Padding="8,6"/>
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Nazwa / Wzorzec Okna:" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text=" ⓘ" Foreground="{StaticResource TextSecondary}" Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSubtle}" Placement="Right">
                                        <TextBlock Text="Widoczna nazwa elementu UI (Title) lub wzorzec.&#x0a;Obsługuje dzikie karty (*) oraz wyrażenia regularne (prefiks REGEX:).&#x0a;Przykłady:&#x0a;• 'Panel Główny | *'&#x0a;• 'REGEX:^Zalogowano jako.*$'" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="5"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBox x:Name="NameTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" Padding="8,6"/>
                    </Grid>

                    <Grid Margin="0,0,0,12" Style="{StaticResource VisibleForUIA}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Automation ID:" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text=" ⓘ" Foreground="{StaticResource TextSecondary}" Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSubtle}" Placement="Right">
                                        <TextBlock Text="Niezmienny i unikalny identyfikator kontrolki w kodzie aplikacji.&#x0a;Najbezpieczniejsza metoda klikania/wyszukiwania.&#x0a;Przykład: 'txtUsername' lub 'btnLogin'" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="5"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBox x:Name="IdTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" Padding="8,6"/>
                    </Grid>

                    <Grid Margin="0,0,0,12" Style="{StaticResource VisibleForTypeText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Wartość / KeePass:" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text=" ⓘ" Foreground="{StaticResource TextSecondary}" Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSubtle}" Placement="Right">
                                        <TextBlock Text="Tekst, który zostanie wpisany przez system z użyciem symulowanej klawiatury.&#x0a;Przykład: 'MojeHaslo123' lub 'KEEPASS:Wpis:Password'" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="5"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBox x:Name="ValueTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" Padding="8,6" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Style="{StaticResource ModernButton}" Content="KeePass" Padding="10,0" Click="InsertKeePass_Click"/>
                    </Grid>

                    <StackPanel Style="{StaticResource VisibleForWindowOp}">
                        <Separator Background="{StaticResource BorderSubtle}" Margin="0,10,0,20"/>
                        <TextBlock Text="Zaawansowana Identyfikacja Okna" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Klasa Okna:" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text=" ⓘ" Foreground="{StaticResource TextSecondary}" Cursor="Help">
                                    <TextBlock.ToolTip>
                                        <ToolTip Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSubtle}" Placement="Right">
                                            <TextBlock Text="Wewnętrzna klasa okna WinAPI. Przydatna gdy tytuł ciągle się zmienia.&#x0a;Obsługuje wildcard (*) oraz Regex (prefiks REGEX:).&#x0a;Przykłady:&#x0a;• 'Chrome_WidgetWin_1'&#x0a;• 'REGEX:^WindowsForms10.*'" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="5"/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <TextBox x:Name="ClassTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" Padding="8,6"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Nazwa Procesu:" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text=" ⓘ" Foreground="{StaticResource TextSecondary}" Cursor="Help">
                                    <TextBlock.ToolTip>
                                        <ToolTip Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSubtle}" Placement="Right">
                                            <TextBlock Text="Nazwa procesu odpowiedzialnego za to okno (bez rozszerzenia).&#x0a;Obsługuje wildcard (*) oraz Regex (prefiks REGEX:).&#x0a;Przykłady:&#x0a;• 'msedge'&#x0a;• 'REGEX:^(msedge|chrome)$'" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="5"/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <TextBox x:Name="ProcessTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" Padding="8,6"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Wymagany Element:" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text=" ⓘ" Foreground="{StaticResource TextSecondary}" Cursor="Help">
                                    <TextBlock.ToolTip>
                                        <ToolTip Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSubtle}" Placement="Right">
                                            <TextBlock Text="Nazwa elementu UIA, który fizycznie musi istnieć głęboko w tym oknie.&#x0a;Zabezpieczenie przy identycznych okienkach o tym samym tytule i klasie.&#x0a;Przykład: 'Opcje Zaawansowane'" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="5"/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </StackPanel>
                            <TextBox x:Name="RequiredContentTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" Padding="8,6"/>
                        </Grid>

                        <GroupBox Header="Wymiary i Pozycja" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderSubtle}" Margin="0,10,0,0" Padding="10">
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="4">
                                    <TextBlock Text="X (Left)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="WinXTextBox" Style="{StaticResource ModernTextBox}" Padding="6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4">
                                    <TextBlock Text="Y (Top)" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="WinYTextBox" Style="{StaticResource ModernTextBox}" Padding="6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4">
                                    <TextBlock Text="Width" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="WinWTextBox" Style="{StaticResource ModernTextBox}" Padding="6"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="4">
                                    <TextBlock Text="Height" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBox x:Name="WinHTextBox" Style="{StaticResource ModernTextBox}" Padding="6"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <Separator Background="{StaticResource BorderSubtle}" Margin="0,15,0,20"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Opóźnienie Startu:" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text=" ⓘ" Foreground="{StaticResource TextSecondary}" Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSubtle}" Placement="Right">
                                        <TextBlock Text="Bezwzględny czas uśpienia skryptu ZANIM przystąpi do tego kroku.&#x0a;Przydatne przy długich ładowaniach interfejsu.&#x0a;Przykład: 2000 (2 sekundy)" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="5"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBox x:Name="DelayTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" Padding="8,6" Margin="0,0,15,0"/>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Timeout:" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text=" ⓘ" Foreground="{StaticResource TextSecondary}" Cursor="Help">
                                <TextBlock.ToolTip>
                                    <ToolTip Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderSubtle}" Placement="Left">
                                        <TextBlock Text="Maksymalny czas, przez który system będzie w pętli szukał elementu/okna.&#x0a;Jeżeli nie znajdzie go w tym czasie, krok zostanie uznany za błąd.&#x0a;Przykład: 5000 (5 sekund)" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="5"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                        <TextBox x:Name="TimeoutTextBox" Grid.Column="3" Style="{StaticResource ModernTextBox}" Padding="8,6"/>
                    </Grid>
                    
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="20" Background="{StaticResource BgCard}" CornerRadius="0,0,10,10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Zapisz zmiany" Click="SaveButton_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Anuluj" Width="100" Click="CancelButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>