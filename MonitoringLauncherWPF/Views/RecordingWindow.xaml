<Window x:Class="MonitoringLauncherWPF.Views.RecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Automation Recorder" 
        Height="780" Width="1200" 
        MinHeight="750" MinWidth="1050"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" 
                  ResizeBorderThickness="6" 
                  UseAeroCaptionButtons="False" 
                  GlassFrameThickness="0" 
                  CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgDark}" 
            CornerRadius="10" 
            BorderBrush="{StaticResource BorderSubtle}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Pasek tytułowy (bez minusa i X) -->
            <Border Grid.Row="0" Background="Transparent" MouseDown="HeaderBorder_MouseDown" Padding="16,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔴" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Automation Recorder" 
                               Foreground="{StaticResource TextPrimary}" 
                               FontWeight="SemiBold" 
                               FontSize="15" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Główna zawartość -->
            <!-- Główna zawartość -->
            <Grid Grid.Row="1" Margin="20,5,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <!-- Panel boczny poszerzony z 380 na 500 -->
                    <ColumnDefinition Width="500"/>
                </Grid.ColumnDefinitions>

                <!-- LEWA STRONA: Konfiguracja i Opis -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,15,0">
                    <StackPanel>
                        
                        <TextBlock Text="Script Setup" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Script Name" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="ScriptNameTextBox" Style="{StaticResource ModernTextBox}" Text="New Automation Script" Height="36" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                                <TextBlock Text="Script Description" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="ScriptDescTextBox" Style="{StaticResource ModernTextBox}" Text="Optional description of what this automation does..." Height="60" Padding="12,8" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"/>

                                <TextBlock Text="Application Type" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="AppTypeComboBox" Style="{StaticResource ModernComboBox}" Height="36" Margin="0,0,0,14" SelectionChanged="AppTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Browser (MS Edge)" IsSelected="True"/>
                                    <ComboBoxItem Content="External Desktop Application"/>
                                </ComboBox>

                                <!-- Kontener dla przeglądarki (URL) -->
                                <StackPanel x:Name="BrowserUrlPanel" Margin="0,0,0,14">
                                    <TextBlock Text="Target URL" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                    
                                    <!-- Siatka dla TextBoxa URL i przycisku KeePass -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="TargetUrlTextBox" Style="{StaticResource ModernTextBox}" Text="https://monitoring.local" Height="36" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="KeePass" Height="36" Padding="16,0" Click="BrowseKeePassUrl_Click"/>
                                    </Grid>

                                    <!-- Nasz sprawdzony kontener z flagami -->
                                    <Border Background="{StaticResource SuccessBg}" BorderBrush="{StaticResource SuccessColor}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Zalecane flagi przeglądarki (Zwiększają niezawodność)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessColor}" Margin="0,0,0,8"/>
                                            <CheckBox x:Name="ChkInPrivate" Content="Tryb prywatny / czysta sesja (-inprivate)" Style="{StaticResource ModernCheckBox}" IsChecked="True" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ChkForceAccessibility" Content="Wymuś widoczność drzewa UI (--force-renderer-accessibility)" Style="{StaticResource ModernCheckBox}" IsChecked="True" Margin="0,0,0,6"/>
                                            <CheckBox x:Name="ChkNewWindow" Content="Wymuś nowe okno (--new-window)" Style="{StaticResource ModernCheckBox}" IsChecked="True"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Kontener dla zewnętrznej aplikacji (Ścieżka .exe) -->
                                <StackPanel x:Name="ExternalAppPanel" Margin="0,0,0,14" Visibility="Collapsed">
                                    <TextBlock Text="Application Path (.exe)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="AppPathTextBox" Style="{StaticResource ModernTextBox}" Text="" Height="36" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="Browse" Height="36" Padding="16,0" Click="BrowseApp_Click"/>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="Dodatkowe Argumenty Startowe (Opcjonalne)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <!-- Domyślnie puste, ponieważ podstawowe argumenty przeglądarki wygenerują się same z checkboxów -->
                                <TextBox x:Name="ArgumentsTextBox" Style="{StaticResource ModernTextBox}" Text="" Height="36" Padding="12,0" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Instrukcje skrótów -->
                        <TextBlock Text="Recording Shortcuts" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="[Ctrl+Shift+1] Record Click" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Capture element under cursor" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="[Ctrl+Shift+2] Record Type Text" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Type manual or KeePass value" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="[Ctrl+Shift+3] Click By Text" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Search HTML links/tags by text" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="[Ctrl+Shift+4] Save Window" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Capture size/position" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="[ESC] Stop &amp; Save" Foreground="{StaticResource DangerColor}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Ends recording session" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- PRAWA STRONA: Panel boczny (Live Steps & Kontrola) -->
                <Border Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Recorded Steps" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                        <Border Grid.Row="2" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15">
                            <Grid>
                                <!-- Tekst widoczny tylko gdy lista jest pusta -->
                                <TextBlock Text="Rozpocznij nagrywanie aby zobaczyć kroki" 
                                           Foreground="{StaticResource TextSecondary}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           FontSize="13" 
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=StepsListBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Przeźroczysty ListBox -->
                                <ListBox x:Name="StepsListBox" 
                                         ItemsSource="{Binding RecordedSteps}" 
                                         Background="Transparent" 
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Margin="0,2,0,6" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Lewa strona: Pełne szczegóły -->
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        
                                                        <!-- Nagłówek: ActionType + ControlType -->
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" Text="{Binding Type}"/>
                                                            
                                                            <StackPanel Orientation="Horizontal">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ControlType}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding ControlType}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Text=" • " Margin="4,0"/>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" Text="{Binding ControlType}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        
                                                        <!-- Główna Nazwa (ElementName) -->
                                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="{Binding ElementName}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                                        
                                                        <!-- Odznaki (Badges) ze zmiennymi danymi -->
                                                        <WrapPanel Orientation="Horizontal">
                                                            
                                                            <!-- Automation ID -->
                                                            <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding AutomationId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding AutomationId}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" Text="{Binding AutomationId, StringFormat='ID: {0}'}"/>
                                                            </Border>

                                                            <!-- Wpisywana Wartość / TAG -->
                                                            <Border Background="{StaticResource RunningBg}" BorderBrush="{StaticResource RunningColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Value}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Value}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource RunningColor}" Text="{Binding Value, StringFormat='Text: {0}'}"/>
                                                            </Border>
                                                            
                                                            <!-- Ścieżka (Tylko dla StartProcess) -->
                                                            <Border Background="{StaticResource SuccessBg}" BorderBrush="{StaticResource SuccessColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding AppPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding AppPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource SuccessColor}" Text="{Binding AppPath}" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    
                                                    <!-- Prawa strona: Czasy (Timeout i Delay) -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Right">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0" Text="Timeout:" VerticalAlignment="Center"/>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}" Text="{Binding TimeoutMs, StringFormat='{}{0} ms'}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0" Text="Delay:" VerticalAlignment="Center"/>
                                                            <TextBox FontSize="12" Height="26" Padding="4,2" Style="{StaticResource ModernTextBox}" Text="{Binding DelayBeforeMs, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Width="45"/>
                                                        </StackPanel>
                                                        
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </Grid>
                        </Border>

                        <!-- Przyciski zarządzania na dole -->
                        <StackPanel Grid.Row="3">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Zamiana GhostButton na ModernButton -->
                                <Button Grid.Column="0" Style="{StaticResource ModernButton}" Content="Edit Step" Click="EditStep_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource DangerButton}" Content="Delete Step" Click="DeleteStep_Click"/>
                            </Grid>
                            
                            <Button x:Name="StartStopRecordingButton" Style="{StaticResource PrimaryButton}" Content="Start Live Recording" Height="40" Click="StartStopRecording_Click" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource DangerButton}" Content="Cancel" Height="36" Click="CancelButton_Click"/>
                        </StackPanel>

                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</Window>