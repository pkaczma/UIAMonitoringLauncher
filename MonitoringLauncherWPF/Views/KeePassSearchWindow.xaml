<Window x:Class="MonitoringLauncherWPF.Views.KeePassSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wyszukiwarka KeePass" Height="540" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource BgDark}" CornerRadius="10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Nagłówek -->
            <Border Grid.Row="0" Background="Transparent" MouseDown="HeaderBorder_MouseDown" Padding="16,12">
                <TextBlock Text="🔒 Wybierz wartość z KeePass" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="15"/>
            </Border>

            <!-- Pasek wyszukiwania i tryb -->
            <StackPanel Grid.Row="1" Margin="20,10,20,10">
                <TextBlock Text="Szukaj (Tytuł wpisu)" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="SearchTextBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10" TextChanged="SearchTextBox_TextChanged"/>

                <TextBlock Text="Co chcesz pobrać?" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                <ComboBox x:Name="FieldTypeComboBox" Style="{StaticResource ModernComboBox}" SelectionChanged="FieldTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Adres URL" Tag="Url"/>
                    <ComboBoxItem Content="Nazwa Użytkownika" Tag="Username"/>
                    <ComboBoxItem Content="Hasło" Tag="Password"/>
                </ComboBox>
            </StackPanel>

            <!-- Lista wyników -->
            <Border Grid.Row="2" Margin="20,0,20,15" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6">
                <ListBox x:Name="EntriesListBox" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Foreground="{StaticResource TextPrimary}" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                         MouseDoubleClick="EntriesListBox_MouseDoubleClick"
                         SelectionChanged="EntriesListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Padding="8,4" FontSize="14"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Podgląd zawartości -->
            <Border Grid.Row="3" Margin="20,0,20,15" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <CheckBox x:Name="PreviewCheckBox" 
                              Grid.Column="0" 
                              Content="Podgląd wartości" 
                              Style="{StaticResource ModernCheckBox}" 
                              VerticalAlignment="Center" 
                              Checked="PreviewCheckBox_CheckedChanged" 
                              Unchecked="PreviewCheckBox_CheckedChanged"/>
                    
                    <TextBlock x:Name="PreviewTextBlock" 
                               Grid.Column="1" 
                               Margin="15,0,0,0" 
                               Foreground="{StaticResource SuccessColor}" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               TextWrapping="Wrap" 
                               VerticalAlignment="Center" 
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Stopka z przyciskami -->
            <Border Grid.Row="4" Padding="20" Background="{StaticResource BgCard}" CornerRadius="0,0,10,10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Content="Wybierz i Wstaw" Click="SelectButton_Click"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Anuluj" Width="100" Click="CancelButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>