<UserControl x:Class="MonitoringLauncherWPF.Views.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Arrow">
    
    <ScrollViewer Margin="0,25,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,15,20">

            <TextBlock Text="KeePass Integration" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="25" Margin="0,0,0,30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock x:Name="KeePassDbPathText" Text="Database: Not configured" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="KeePassPwdStatusText" Text="Password: Not saved" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="KeePassDbInfoText" Text="Entries: 0  •  File modified: Unknown" FontSize="13" Foreground="{StaticResource SuccessColor}" Margin="0,4,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="KeePassLastReloadText" Text="Last Cache Reload: Unknown" FontSize="13" Foreground="{StaticResource AccentPrimary}" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Vertical">
                        <Button Style="{StaticResource ModernButton}" Content="Configure KeePass" Click="ConfigureKeePass_Click" Padding="20,10"/>
                        <Button x:Name="ManualReloadBtn" Style="{StaticResource GhostButton}" Content="Manual Reload" Click="ManualReloadBtn_Click" Padding="20,8" Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Automation Settings" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="25" Margin="0,0,0,30">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="App Launch Delay (ms)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Wait time between launching the monitoring app and starting the macro." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <TextBox x:Name="LaunchDelayInput" Grid.Column="1" Style="{StaticResource ModernTextBox}" VerticalAlignment="Center" VerticalContentAlignment="Center" Height="36" Padding="12,0" Cursor="IBeam"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderSubtle}" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Default Step Delay (ms)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Default wait time between individual automation steps." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <TextBox x:Name="StepDelayInput" Grid.Column="1" Style="{StaticResource ModernTextBox}" VerticalAlignment="Center" VerticalContentAlignment="Center" Height="36" Padding="12,0" Cursor="IBeam"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Logging Settings" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,15"/>
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="25" Margin="0,0,0,30">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Save Macro Execution Logs" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Log detailed step-by-step information when a macro is running." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="SaveMacroLogsToggle" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderSubtle}" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Log Retention Time (Days)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Older logs will be automatically deleted on startup." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <TextBox x:Name="LogRetentionInput" Grid.Column="1" Style="{StaticResource ModernTextBox}" VerticalAlignment="Center" VerticalContentAlignment="Center" Height="36" Padding="12,0" Cursor="IBeam"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="SaveStatusText" Foreground="{StaticResource SuccessColor}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Save Settings" Width="140" Height="36" Click="SaveSettings_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>