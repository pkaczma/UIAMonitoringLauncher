<Window x:Class="MonitoringLauncherWPF.Views.ScriptEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Automation Configuration" 
        Height="780" Width="1200" 
        MinHeight="750" MinWidth="1050"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      ResizeBorderThickness="6" 
                      UseAeroCaptionButtons="False" 
                      GlassFrameThickness="0" 
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgDark}" 
            CornerRadius="10" 
            BorderBrush="{StaticResource BorderSubtle}" 
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseDown="HeaderBorder_MouseDown" Padding="16,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Edit Automation Configuration" 
                               Foreground="{StaticResource TextPrimary}" 
                               FontWeight="SemiBold" 
                               FontSize="15" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="20,5,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="500"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,15,0">
                    <StackPanel>
                        
                        <TextBlock Text="Script Configuration" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Script Name" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <TextBox x:Name="ScriptNameTextBox" Style="{StaticResource ModernTextBox}" Height="36" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                                <TextBlock Text="Primary App Path or Target URL" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="AppPathTextBox" Style="{StaticResource ModernTextBox}" Height="36" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="Browse" Height="36" Padding="16,0" Click="BrowseApp_Click"/>
                                </Grid>

                                <TextBlock Text="Launch Arguments" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ArgumentsTextBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" Height="36" Padding="12,0" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource ModernButton}" Content="KeePass" Height="36" Padding="16,0" Click="BrowseKeePass_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Script Steps" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                        <Border Grid.Row="1" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,15">
                            <Grid>
                                <ListBox x:Name="StepsListBox" 
                                         ItemsSource="{Binding Steps}" 
                                         Background="Transparent" 
                                         BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Margin="0,2,0,6" Padding="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" Text="{Binding Type}"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ControlType}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding ControlType}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Text=" • " Margin="4,0"/>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" Text="{Binding ControlType}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        
                                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="{Binding ElementName}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                                        
                                                        <WrapPanel Orientation="Horizontal">
                                                            <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding AutomationId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding AutomationId}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" Text="{Binding AutomationId, StringFormat='ID: {0}'}"/>
                                                            </Border>

                                                            <Border Background="{StaticResource RunningBg}" BorderBrush="{StaticResource RunningColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Value}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Value}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource RunningColor}" Text="{Binding Value, StringFormat='Text: {0}'}"/>
                                                            </Border>
                                                            
                                                            <Border Background="{StaticResource SuccessBg}" BorderBrush="{StaticResource SuccessColor}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,4">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding AppPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding AppPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" Foreground="{StaticResource SuccessColor}" Text="{Binding AppPath}" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" HorizontalAlignment="Right">
                                                            <TextBlock FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,4,0" Text="Timeout:" VerticalAlignment="Center"/>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextPrimary}" Text="{Binding TimeoutMs, StringFormat='{}{0} ms'}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,0" Text="Delay:" VerticalAlignment="Center"/>
                                                            <TextBox FontSize="12" Height="26" Padding="4,2" Style="{StaticResource ModernTextBox}" Text="{Binding DelayBeforeMs, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Width="45"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource ModernButton}" Content="Edit Step" Click="EditStep_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource DangerButton}" Content="Delete Step" Click="DeleteStep_Click"/>
                            </Grid>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="Cancel" Height="36" Click="CancelButton_Click"/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Save Changes" Height="36" Click="SaveButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>