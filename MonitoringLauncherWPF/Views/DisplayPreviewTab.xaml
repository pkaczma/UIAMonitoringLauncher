<UserControl x:Class="MonitoringLauncherWPF.Views.DisplayPreviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform" Margin="0,20,0,0">
        <Canvas Width="5760" Height="3240" Background="Transparent">
            
            <!-- 1. Top Monitor -->
            <Border Canvas.Left="1920" Canvas.Top="0" Width="1920" Height="1080" BorderBrush="#22222D" BorderThickness="15" Background="#050508" CornerRadius="20">
                <TextBlock Text="DISPLAY 4" Foreground="#2A2A35" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 2. Left Monitor -->
            <Border Canvas.Left="0" Canvas.Top="1080" Width="1920" Height="1080" BorderBrush="#22222D" BorderThickness="15" Background="#050508" CornerRadius="20">
                <TextBlock Text="DISPLAY 2" Foreground="#2A2A35" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 3. Center Monitor (Primary) -->
            <Border Canvas.Left="1920" Canvas.Top="1080" Width="1920" Height="1080" BorderBrush="#383846" BorderThickness="15" Background="#050508" CornerRadius="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="DISPLAY 1" Foreground="#383846" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Primary" Foreground="#2A2A35" FontSize="40" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 4. Right Monitor -->
            <Border Canvas.Left="3840" Canvas.Top="1080" Width="1920" Height="1080" BorderBrush="#22222D" BorderThickness="15" Background="#050508" CornerRadius="20">
                <TextBlock Text="DISPLAY 3" Foreground="#2A2A35" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- 5. Bottom Monitor -->
            <Border Canvas.Left="1920" Canvas.Top="2160" Width="1920" Height="1080" BorderBrush="#22222D" BorderThickness="15" Background="#050508" CornerRadius="20">
                <TextBlock Text="DISPLAY 5" Foreground="#2A2A35" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Overlays -->
            <!-- Overlay 1: Grafana -->
            <Border Canvas.Left="25" Canvas.Top="1105" Width="1870" Height="1030" Background="#1AF59E0B" BorderBrush="#80F59E0B" BorderThickness="2" CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🛡 Grafana Dashboard" Foreground="#F59E0B" FontSize="50" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Global Security Automations" Foreground="#A0F59E0B" FontSize="35" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Overlay 2: Splunk -->
            <Border Canvas.Left="3865" Canvas.Top="1105" Width="1870" Height="1030" Background="#1A10B981" BorderBrush="#8010B981" BorderThickness="2" CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📊 Splunk Analytics" Foreground="#10B981" FontSize="50" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Global Security Automations" Foreground="#A010B981" FontSize="35" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Overlay 3: App Logs -->
            <Border Canvas.Left="1945" Canvas.Top="1105" Width="920" Height="1030" Background="#1A3B82F6" BorderBrush="#803B82F6" BorderThickness="2" CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📝 App Logs" Foreground="#3B82F6" FontSize="50" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Core Infrastructure" Foreground="#A03B82F6" FontSize="35" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Overlay 4: Resources -->
            <Border Canvas.Left="2895" Canvas.Top="1105" Width="920" Height="1030" Background="#1A8B5CF6" BorderBrush="#808B5CF6" BorderThickness="2" CornerRadius="12">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💻 Sys Resources" Foreground="#8B5CF6" FontSize="50" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Core Infrastructure" Foreground="#A08B5CF6" FontSize="35" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Viewbox>
</UserControl>