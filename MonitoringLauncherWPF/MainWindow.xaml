<Window x:Class="MonitoringLauncherWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MonitoringLauncherWPF.Views"
        Title="Monitoring Launcher" Height="850" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#F3F4F6" FontFamily="Segoe UI, -apple-system, Roboto, sans-serif"
        Loaded="Window_Loaded">
        
        <WindowChrome.WindowChrome>
            <WindowChrome 
            ResizeBorderThickness="6" 
            CaptionHeight="0" 
            CornerRadius="12" 
            GlassFrameThickness="0"/>
        </WindowChrome.WindowChrome>

    <!-- ClipToBounds ensures content doesn't bleed out of the rounded corners -->
    <Border Background="{StaticResource BgDark}" CornerRadius="12" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Application Header & Custom Title Bar -->
            <Border x:Name="HeaderBorder" MouseLeftButtonDown="HeaderBorder_MouseDown" Background="Transparent" Padding="25,20,15,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦" FontSize="20" Foreground="{StaticResource AccentPrimary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Monitoring Launcher" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="#1AFFFFFF" CornerRadius="4" Margin="12,0,0,0" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="v1.1" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        </Border>
                    </StackPanel>

                    <!-- Record Button -->
                    <Button x:Name="RecordButton" Click="RecordButton_Click" Grid.Column="1" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="0,0,20,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Record New" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Window Control Buttons (Minimize & Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinimizeButton" Click="MinimizeButton_Click" Style="{StaticResource WindowControlButton}" Margin="0,0,5,0">
                            <TextBlock Text="—" FontSize="12" FontWeight="Bold" Margin="0,4,0,0"/>
                        </Button>
                        <Button x:Name="CloseButton" Click="CloseButton_Click" Style="{StaticResource WindowCloseButton}">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Main Content Area with Tabs -->
            <TabControl Grid.Row="1" Margin="30,10,30,30">
                <TabItem Header="Automations">
                    <views:AutomationsTab />
                </TabItem>
                <TabItem Header="Display Layout Preview">
                    <views:DisplayPreviewTab />
                </TabItem>
                <TabItem Header="Settings">
                    <views:SettingsTab />
                </TabItem>
            </TabControl>
            
        </Grid>
    </Border>
</Window>